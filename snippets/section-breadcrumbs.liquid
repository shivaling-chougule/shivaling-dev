{%- comment -%}
  Renders breadcrumbs using pure Liquid.
  Accepts:
  - color: {String} text color (e.g. '#fff'). Default: inherit
  - wrapper_class: {String} extra classes on the wrapper div
  Usage:
  {% render 'section-breadcrumbs', color: '#fff', wrapper_class: 'container' %}
{%- endcomment -%}

{%- liquid
  assign breadcrumb_color = color | default: 'inherit'
-%}

  <div class="collection-banner__breadcrumb-wrap {{ wrapper_class }}">
    <nav
      class="breadcrumb section-breadcrumb-nav"
      role="navigation"
      aria-label="breadcrumbs"
      data-breadcrumb-nav
      data-template="{{ template.name }}"
      {%- if template.name == 'collection' and collection %}
        data-collection-title="{{ collection.title | escape }}"
        data-collection-url="{{ collection.url }}"
      {%- endif %}
      {%- if template.name == 'list-collections' %}
        data-collection-title="{{ page_title | escape }}"
        data-collection-url="{{ routes.collections_url }}"
      {%- endif %}
      {%- if template.name == 'product' and product %}
        data-product-title="{{ product.title | escape }}"
      {%- endif %}
      data-breadcrumb-color="{{ breadcrumb_color }}"
      style="color: {{ breadcrumb_color }}; display: flex; align-items: center; flex-wrap: wrap;"
    >

      <a href="{{ routes.root_url }}" title="{{ 'general.breadcrumbs.home' | t }}" class="breadcrumb__link" style="color: {{ breadcrumb_color }};">
        {{ 'general.breadcrumbs.home' | t }}
      </a>

