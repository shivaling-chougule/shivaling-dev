{%- comment -%}
  Renders breadcrumbs using pure Liquid.
  Accepts:
  - color: {String} text color (e.g. '#fff'). Default: inherit
  - wrapper_class: {String} extra classes on the wrapper div
  Usage:
  {% render 'section-breadcrumbs', color: '#fff', wrapper_class: 'container' %}
{%- endcomment -%}

{%- liquid
  assign breadcrumb_color = color | default: 'inherit'
-%}

  <div class="collection-banner__breadcrumb-wrap {{ wrapper_class }}">
    <nav class="breadcrumb section-breadcrumb-nav" role="navigation" aria-label="breadcrumbs" style="color: {{ breadcrumb_color }}; display: flex; align-items: center; gap: 8px; flex-wrap: wrap;">

      <a href="{{ routes.root_url }}" title="{{ 'general.breadcrumbs.home' | t }}" class="breadcrumb__link" style="color: {{ breadcrumb_color }};">
        {{ 'general.breadcrumbs.home' | t }}
      </a>

      {%- if template.name == 'collection' and collection -%}
        
        {%- comment -%}
          Main Collection Title
        {%- endcomment -%}
        <span class="breadcrumb__delimiter" style="color: {{ breadcrumb_color }} !important;">/</span>
        <a href="{{ collection.url }}" class="breadcrumb__link" style="color: {{ breadcrumb_color }};">
          {{ collection.title | escape }}
        </a>

      {%- elsif template.name == 'product' and product -%}
        
        {%- if product.collections.size > 0 -%}
          <span class="breadcrumb__delimiter" style="color: {{ breadcrumb_color }} !important;">/</span>
          <a href="{{ product.collections[0].url }}" class="breadcrumb__link" style="color: {{ breadcrumb_color }};">
            {{ product.collections[0].title | escape }}
          </a>
        {%- endif -%}

        <span class="breadcrumb__delimiter" style="color: {{ breadcrumb_color }} !important;">/</span>
        <span class="breadcrumb__current" style="color: #000;">
          {{ product.title | escape }}
        </span>

      {%- elsif template.name == 'article' and article -%}
        
        {%- if blog -%}
          <span class="breadcrumb__delimiter" style="color: {{ breadcrumb_color }} !important;">/</span>
          <a href="{{ blog.url }}" class="breadcrumb__link" style="color: {{ breadcrumb_color }};">
            {{ blog.title | escape }}
          </a>
        {%- endif -%}

        <span class="breadcrumb__delimiter" style="color: {{ breadcrumb_color }} !important;">/</span>
        <span class="breadcrumb__current" style="color: {{ breadcrumb_color }};">
          {{ article.title | escape }}
        </span>

      {%- elsif template.name == 'blog' and blog -%}
        
        <span class="breadcrumb__delimiter" style="color: {{ breadcrumb_color }} !important;">/</span>
        <span style="color: {{ breadcrumb_color }};">
          {{ blog.title | escape }}
        </span>

      {%- elsif template.name == 'page' and page -%}
        
        <span class="breadcrumb__delimiter" style="color: {{ breadcrumb_color }} !important;">/</span>
        <span style="color: {{ breadcrumb_color }};">
          {{ page.title | escape }}
        </span>

      {%- elsif page_title != blank and request.page_type != 'index' -%}
        
        <span class="breadcrumb__delimiter" style="color: {{ breadcrumb_color }} !important;">/</span>
        <span style="color: {{ breadcrumb_color }};">
          {{ page_title | escape }}
        </span>

      {%- endif -%}

    </nav>
  </div>
